{
  "name": "@lyvox/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts --name initial_schema",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "tsx scripts/seed.mjs apply",
    "db:seed:validate": "tsx scripts/seed.mjs validate",
    "db:seed:verify": "tsx scripts/seed.mjs verify",
    "db:verify": "node scripts/database.mjs verify",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lyvox/auth": "workspace:*",
    "@lyvox/permissions": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1"
  }
}
