{
  "name": "@lyvox/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/local-dev.mjs",
    "lint": "oxlint src vitest.config.ts",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "10.0.1",
    "@lyvox/auth": "workspace:*",
    "@lyvox/database": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "4.1.10",
    "oxlint": "1.75.0",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
